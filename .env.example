# ==============================================================================
# CONFIGURACAO LANGSMITH
# Documentacao: https://docs.smith.langchain.com/
# ==============================================================================

# Habilita o tracing automatico de todas as chamadas LangChain no LangSmith UI
LANGSMITH_TRACING=true

# Endpoint padrao da API LangSmith (nao altere salvo uso de instancia self-hosted)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Chave de API do LangSmith
# Obter em: https://smith.langchain.com/settings -> API Keys -> Create API Key
LANGSMITH_API_KEY=

# Nome do projeto no LangSmith onde os experimentos serao registrados
LANGSMITH_PROJECT=bug_to_user_story

# Seu username no LangSmith Hub (necessario para push do prompt v2)
# Como descobrir: publique qualquer prompt no Hub, abra-o e localize seu username
# na URL: https://smith.langchain.com/hub/<USERNAME>/nome-do-prompt
# Alias aceito: LANGSMITH_USERNAME (nome usado no SPEC.md)
USERNAME_LANGSMITH_HUB=

# ==============================================================================
# CONFIGURACAO DO PROVEDOR LLM
# Escolha "google" (gratuito via Google AI Studio) ou "openai"
# ==============================================================================

# Provedor ativo: "google" | "openai"
LLM_PROVIDER=google

# Modelo de resposta (geração das user stories)
# Para Google: gemini-2.5-flash | Para OpenAI: gpt-4o-mini
LLM_MODEL=gemini-2.5-flash

# Modelo avaliador (LLM-as-judge nas 5 metricas)
# Para Google: gemini-2.5-flash | Para OpenAI: gpt-4o
EVAL_MODEL=gemini-2.5-flash

# Limite de requisicoes por minuto ao LLM (rate limiter compartilhado).
# Plano gratuito do Gemini: 5 req/min em gemini-2.5-flash -> default 4.5.
# OpenAI: default 60. Use 0 para desativar.
#LLM_REQUESTS_PER_MINUTE=4.5

# Retentativas automaticas em erro 429/5xx (default: 6)
#LLM_MAX_RETRIES=6

# Exemplos avaliados em paralelo pelo LangSmith (default: 1)
#EVAL_MAX_CONCURRENCY=1

# ==============================================================================
# CREDENCIAIS OPENAI (necessario apenas se LLM_PROVIDER=openai)
# Obter em: https://platform.openai.com/api-keys
# ==============================================================================
OPENAI_API_KEY=

# Modelo de resposta OpenAI (alias SPEC: OPENAI_RESPONSE_MODEL)
#OPENAI_RESPONSE_MODEL=gpt-4o-mini

# Modelo avaliador OpenAI (alias SPEC: OPENAI_EVAL_MODEL)
#OPENAI_EVAL_MODEL=gpt-4o

# ==============================================================================
# CREDENCIAIS GOOGLE GEMINI (necessario apenas se LLM_PROVIDER=google)
# Obter em: https://aistudio.google.com/app/apikey  (plano gratuito disponivel)
# ==============================================================================
GOOGLE_API_KEY=

# Modelo Gemini utilizado tanto para resposta quanto para avaliacao
# (alias SPEC: GEMINI_MODEL)
#GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# NOTAS DE COMPATIBILIDADE
# Este arquivo segue os nomes do scaffold oficial do curso (LLM_MODEL, EVAL_MODEL,
# USERNAME_LANGSMITH_HUB). O SPEC.md referencia nomes alternativos
# (OPENAI_RESPONSE_MODEL, OPENAI_EVAL_MODEL, GEMINI_MODEL, LANGSMITH_USERNAME).
# Ambos os conjuntos sao aceitos por src/utils.py (env_first): o nome do scaffold
# tem prioridade; o alias do SPEC e usado como fallback quando o primeiro esta vazio.
# ==============================================================================
